<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enterprise IT Help-Desk System</title>
    <style>
        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --primary-light: #eef2ff;
            --bg-main: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            
            --status-open-bg: #e0f2fe;
            --status-open-text: #0369a1;
            --status-progress-bg: #fef3c7;
            --status-progress-text: #b45309;
            --status-resolved-bg: #dcfce7;
            --status-resolved-text: #15803d;
            
            --danger-bg: #fef2f2;
            --danger-border: #fca5a5;
            --danger-text: #991b1b;
            
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
            --radius-md: 10px;
            --radius-lg: 14px;
        }

        * {
            box-sizing: border-box;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        /* Top Navigation Header */
        header {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            color: #ffffff;
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: var(--shadow-md);
        }

        header h1 {
            margin: 0;
            font-size: 1.4rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        header h1 span {
            color: #818cf8;
        }

        header .subtitle {
            font-size: 0.85rem;
            color: #94a3b8;
            margin: 4px 0 0 0;
        }

        .main-wrapper {
            max-width: 1300px;
            margin: 30px auto;
            padding: 0 20px;
        }

        /* Metrics Overview Cards */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 25px;
        }

        .metric-card {
            background: var(--card-bg);
            padding: 16px 20px;
            border-radius: var(--radius-md);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .metric-card .title {
            font-size: 0.8rem;
            text-transform: uppercase;
            font-weight: 600;
            color: var(--text-muted);
        }

        .metric-card .value {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--text-main);
            margin-top: 4px;
        }

        /* Dashboard Layout */
        .dashboard-layout {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 25px;
        }

        @media (max-width: 900px) {
            .dashboard-layout {
                grid-template-columns: 1fr;
            }
        }

        .panel {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            padding: 24px;
            margin-bottom: 25px;
        }

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 14px;
            margin-bottom: 20px;
        }

        .panel-header h2 {
            margin: 0;
            font-size: 1.1rem;
            font-weight: 700;
        }

        /* Form Controls */
        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            font-size: 0.825rem;
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 6px;
        }

        .form-control {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            font-size: 0.9rem;
            background-color: #f8fafc;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }

        textarea.form-control {
            resize: vertical;
            min-height: 90px;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 10px 18px;
            font-size: 0.9rem;
            font-weight: 600;
            border-radius: var(--radius-md);
            border: none;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background-color: var(--primary);
            color: #ffffff;
        }

        .btn-primary:hover {
            background-color: var(--primary-hover);
        }

        .btn-success {
            background-color: #16a34a;
            color: #ffffff;
        }

        .btn-success:hover {
            background-color: #15803d;
        }

        .btn-outline {
            background-color: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-main);
        }

        .btn-outline:hover {
            background-color: var(--bg-main);
        }

        /* Ticket List Items */
        .ticket-list {
            list-style: none;
            padding: 0;
            margin: 0;
            max-height: 480px;
            overflow-y: auto;
        }

        .ticket-card {
            padding: 14px 16px;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            margin-bottom: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
            background: #ffffff;
        }

        .ticket-card:hover {
            border-color: var(--primary);
            box-shadow: var(--shadow-md);
            transform: translateY(-1px);
        }

        .ticket-card.active {
            border-color: var(--primary);
            background-color: var(--primary-light);
        }

        .ticket-card-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
        }

        .ticket-id {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--text-muted);
        }

        .ticket-title {
            font-size: 0.925rem;
            font-weight: 600;
            margin: 0 0 4px 0;
            color: var(--text-main);
        }

        .ticket-meta {
            font-size: 0.775rem;
            color: var(--text-muted);
        }

        /* Status Badges */
        .badge {
            display: inline-block;
            padding: 4px 10px;
            font-size: 0.725rem;
            font-weight: 700;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .badge-open { background: var(--status-open-bg); color: var(--status-open-text); }
        .badge-progress { background: var(--status-progress-bg); color: var(--status-progress-text); }
        .badge-resolved { background: var(--status-resolved-bg); color: var(--status-resolved-text); }

        /* Detail Workspace */
        .ticket-header-details {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 15px;
        }

        .description-box {
            background-color: #f8fafc;
            border-left: 4px solid var(--primary);
            padding: 14px 18px;
            border-radius: 0 var(--radius-md) var(--radius-md) 0;
            margin: 15px 0 25px 0;
            font-size: 0.95rem;
            line-height: 1.5;
        }

        /* Responses Stream */
        .responses-stream {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin: 15px 0 25px 0;
        }

        .response-bubble {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            padding: 12px 16px;
        }

        .response-bubble .sender-name {
            font-weight: 700;
            font-size: 0.85rem;
            color: var(--text-main);
        }

        .response-bubble .timestamp {
            font-size: 0.75rem;
            color: var(--text-muted);
            float: right;
        }

        .response-bubble p {
            margin: 6px 0 0 0;
            font-size: 0.9rem;
            color: #334155;
        }

        /* Edge Case Warning Banner */
        .edge-case-alert {
            background-color: var(--danger-bg);
            border: 1px solid var(--danger-border);
            color: var(--danger-text);
            padding: 14px 18px;
            border-radius: var(--radius-md);
            margin-bottom: 20px;
            font-size: 0.875rem;
            line-height: 1.4;
            display: none;
            animation: fadeIn 0.3s ease-in-out;
        }

        .edge-case-alert strong {
            display: block;
            margin-bottom: 4px;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-5px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <header>
        <div>
            <h1><span>⚡ Enterprise</span> Help-Desk Portal</h1>
            <p class="subtitle">Topic 11: Service Desk Workflow & Automated Resolution Edge Case Validation[cite: 2]</p>
        </div>
    </header>

    <div class="main-wrapper">
        <!-- Live System Metrics -->
        <div class="metrics-grid">
            <div class="metric-card">
                <div>
                    <div class="title">Total Tickets</div>
                    <div class="value" id="statTotal">0</div>
                </div>
            </div>
            <div class="metric-card">
                <div>
                    <div class="title">Active (Open)</div>
                    <div class="value" style="color: var(--status-open-text);" id="statOpen">0</div>
                </div>
            </div>
            <div class="metric-card">
                <div>
                    <div class="title">In Progress</div>
                    <div class="value" style="color: var(--status-progress-text);" id="statProgress">0</div>
                </div>
            </div>
            <div class="metric-card">
                <div>
                    <div class="title">Resolved</div>
                    <div class="value" style="color: var(--status-resolved-text);" id="statResolved">0</div>
                </div>
            </div>
        </div>

        <div class="dashboard-layout">
            <!-- Left Side Control Panel -->
            <div>
                <!-- Create Ticket Form -->
                <div class="panel">
                    <div class="panel-header">
                        <h2>Open New Ticket</h2>
                    </div>
                    <form id="ticketForm">
                        <div class="form-group">
                            <label for="userName">Requester Name</label>
                            <input type="text" id="userName" class="form-control" required placeholder="e.g. Alex Johnson">
                        </div>
                        <div class="form-group">
                            <label for="ticketSubject">Issue Summary</label>
                            <input type="text" id="ticketSubject" class="form-control" required placeholder="e.g. Server Access Denied">
                        </div>
                        <div class="form-group">
                            <label for="ticketPriority">Priority Level</label>
                            <select id="ticketPriority" class="form-control">
                                <option value="Low">Low Priority</option>
                                <option value="Medium" selected>Medium Priority</option>
                                <option value="High">High Priority</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="ticketDescription">Problem Description</label>
                            <textarea id="ticketDescription" class="form-control" required placeholder="Describe system details and error steps..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Submit Ticket</button>
                    </form>
                </div>

                <!-- Ticket Directory -->
                <div class="panel">
                    <div class="panel-header">
                        <h2>Ticket Queue</h2>
                    </div>
                    <ul id="ticketList" class="ticket-list">
